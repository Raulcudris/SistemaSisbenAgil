# Opcional en desarrollo. Déjelo comentado para usar la ruta relativa /api y
# el proxy de Next.js (recomendado: funciona igual desde localhost o por IP).
# NEXT_PUBLIC_API_URL=/api

# Solo si desea que el navegador llame al backend directamente, sin proxy:
# NEXT_PUBLIC_API_URL=http://192.168.1.18:8088/api

# Agente local de impresión (se ejecuta en el mismo equipo del kiosco).
NEXT_PUBLIC_PRINT_AGENT_URL=http://127.0.0.1:17777
