# Copie este archivo como .env antes de desplegar:
#   Copy-Item .env.example .env
# y cambie todas las contraseÃ±as y el secreto JWT.

# Puertos en el host (los que NO estÃ¡n ocupados en el servidor).
# Ya estÃ¡n ocupados por appsisben u otros servicios: 80, 3000, 6095, 8069,
# 8080, 2404, 8097 y 8098.
FRONTEND_PORT=3001
BACKEND_PORT=8088

# Base de datos (solo accesible dentro de Docker).
DB_NAME=dispensamaster
DB_USER=dispensamaster
DB_PASSWORD=R00t2026*
MYSQL_ROOT_PASSWORD=R00t2026*

# Secreto para firmar los JWT. Use al menos 32 caracteres aleatorios.
# Puede generarlo con:  openssl rand -base64 48
APP_JWT_SECRET=eLWIrSUIHoMuJEAEJVpY2p+scvWJeoiOFE3ZyueWRZNuOOKwKkHTnGVYY+LS4r99ubyTcV0BuZva8AIc+BCIMw==
APP_JWT_HOURS=12

# Docker Hub: usuario y versiÃ³n de las imÃ¡genes.
# Se usan al construir/publicar y al desplegar en el servidor.
DOCKERHUB_USERNAME=raulcudris
BACKEND_VERSION=2.0.3
FRONTEND_VERSION=2.0.3

# Herramientas opcionales para inspeccionar la base (no afectan a la app).
# DBeaver usa el overlay docker-compose.dbeaver.yml en 127.0.0.1:3308.
# Para conectarte desde otro PC, cambia DB_VIEW_BIND a 0.0.0.0 (solo LAN).
DB_VIEW_BIND=127.0.0.1
DB_VIEW_PORT=3308
# Adminer (navegador) usa docker-compose.adminer.yml.
ADMINER_PORT=8099

# Copias de seguridad (servicio "backup")
# Hora diaria (24 h) a la que se ejecuta la copia, en zona America/Bogota.
BACKUP_SCHEDULE_TIME=02:00
# DÃ­as que se conservan las copias antes de borrarlas automÃ¡ticamente.
BACKUP_RETENTION_DAYS=14

# OrÃ­genes permitidos si algÃºn cliente llama a la API directamente.
# Con el proxy de Next.js normalmente no hace falta cambiarlo.
# APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:[*],http://192.168.*.*:[*]
