# Copie este archivo como .env y ajuste los valores si es necesario.

# Solo escucha en el equipo local del kiosco.
PRINT_AGENT_HOST=127.0.0.1
PRINT_AGENT_PORT=17777

# Opcional. Si se omite, usa la impresora predeterminada de Windows.
# PRINT_AGENT_PRINTER=XP-80C-USB

# Opcional. Por defecto se permiten localhost y direcciones de red privada.
# Para restringir o agregar un dominio público, use una lista separada por comas.
# PRINT_AGENT_ORIGINS=http://localhost:3001,http://192.168.1.50:3001
